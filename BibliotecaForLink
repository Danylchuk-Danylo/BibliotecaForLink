using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using System.Text.Json;

namespace BrowserLinkController
{
    public enum LinkStatus
    {
        Unspecified = 0,
        Allowed = 1,
        Denied = 2,
        AllowedTemporarily = 3
    }

    public class LinkEntry
    {
        public string Url { get; set; }
        public LinkStatus Status { get; set; }
        public DateTime? AllowedUntil { get; set; }
        public bool IsFavorite { get; set; }
    }

    public class LinkManager
    {
        private Dictionary<string, LinkEntry> _links;
        private readonly string _filePath;

        public LinkManager(string filePath = "links.json")
        {
            _filePath = filePath;
            _links = new Dictionary<string, LinkEntry>(StringComparer.OrdinalIgnoreCase);
            LoadFromFile();
        }

        public List<LinkEntry> GetAllLinks()
        {
            return _links.Values.ToList();
        }

        public void ClearLinks()
        {
            _links.Clear();
            SaveToFile();
        }

        public void AddLink(string url, LinkStatus status = LinkStatus.Unspecified, DateTime? allowedUntil = null)
        {
            if (string.IsNullOrWhiteSpace(url)) throw new ArgumentException("URL не може бути порожнім.");

            if (!_links.ContainsKey(url))
            {
                _links[url] = new LinkEntry
                {
                    Url = url,
                    Status = status,
                    AllowedUntil = status == LinkStatus.AllowedTemporarily ? allowedUntil : null,
                    IsFavorite = false
                };
                SaveToFile();
            }
        }

        public void UpdateStatus(string url, LinkStatus newStatus, DateTime? allowedUntil = null)
        {
            if (_links.TryGetValue(url, out var entry))
            {
                entry.Status = newStatus;
                entry.AllowedUntil = newStatus == LinkStatus.AllowedTemporarily ? allowedUntil : null;
                SaveToFile();
            }
            else
            {
                throw new KeyNotFoundException($"Посилання {url} не знайдено в базі.");
            }
        }

        public bool RemoveLink(string url)
        {
            bool isRemoved = _links.Remove(url);
            if (isRemoved)
            {
                SaveToFile();
            }
            return isRemoved;
        }

        public void ToggleFavorite(string url, bool isFavorite)
        {
            if (_links.TryGetValue(url, out var entry))
            {
                entry.IsFavorite = isFavorite;
                SaveToFile();
            }
            else
            {
                throw new KeyNotFoundException($"Посилання {url} не знайдено в базі.");
            }
        }

        public bool IsLinkAllowedNow(string url)
        {
            if (!_links.TryGetValue(url, out var entry))
                return true;

            if (entry.Status == LinkStatus.Allowed) return true;
            if (entry.Status == LinkStatus.Denied) return false;
            
            if (entry.Status == LinkStatus.AllowedTemporarily)
            {
                return entry.AllowedUntil.HasValue && entry.AllowedUntil.Value > DateTime.Now;
            }

            return false;
        }

        private void SaveToFile()
        {
            var options = new JsonSerializerOptions { WriteIndented = true };
            string jsonString = JsonSerializer.Serialize(_links.Values, options);
            File.WriteAllText(_filePath, jsonString);
        }

        private void LoadFromFile()
        {
            if (!File.Exists(_filePath)) return;

            try
            {
                string jsonString = File.ReadAllText(_filePath);
                var loadedLinks = JsonSerializer.Deserialize<List<LinkEntry>>(jsonString);

                if (loadedLinks != null)
                {
                    _links = loadedLinks.ToDictionary(l => l.Url, l => l, StringComparer.OrdinalIgnoreCase);
                }
            }
            catch
            {
                _links = new Dictionary<string, LinkEntry>(StringComparer.OrdinalIgnoreCase);
            }
        }
    }
}
